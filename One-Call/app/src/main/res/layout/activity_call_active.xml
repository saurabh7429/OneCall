<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onecall_background"
    tools:context=".ui.calls.CallActiveActivity">

    <ImageView
        android:id="@+id/callActiveAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_caller_avatar_circle"
        android:contentDescription="@string/call_active_title"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="@color/onecall_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/callActiveNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/onecall_blue_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callActiveAvatar"
        tools:text="Caller Name" />

    <TextView
        android:id="@+id/callActiveNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/onecall_gray"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callActiveNameText"
        tools:text="+91 98765 43210" />

    <TextView
        android:id="@+id/callActiveTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/call_active_timer_default"
        android:textColor="@color/onecall_blue_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callActiveNumberText" />

    <TextView
        android:id="@+id/callActiveDeviceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/onecall_blue"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callActiveTimerText"
        tools:text="You are on: OneCall Device" />

    <LinearLayout
        android:id="@+id/callActiveActionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callActiveDeviceText">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callActiveMuteButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_action_selector"
                android:contentDescription="@string/mute_label"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/call_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mute_label"
                android:textColor="@color/onecall_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callActiveSpeakerButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_action_selector"
                android:contentDescription="@string/speaker_label"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:tint="@color/call_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/speaker_label"
                android:textColor="@color/onecall_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callActiveTransferButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_action_selector"
                android:contentDescription="@string/transfer_label"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_send"
                android:tint="@color/call_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/transfer_label"
                android:textColor="@color/onecall_gray"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/callActiveEndButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_call_decline_circle"
        android:contentDescription="@string/end_call"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/onecall_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
