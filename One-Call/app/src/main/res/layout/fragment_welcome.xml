<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onecall_background"
    tools:context=".ui.screens.WelcomeFragment">

    <LinearLayout
        android:id="@+id/welcomeContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="24dp"
        android:paddingRight="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/logoPlaceholder"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_logo_placeholder" />

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif"
            android:text="@string/app_name"
            android:textColor="@color/onecall_blue"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/welcome_tagline"
            android:textColor="@color/onecall_gray"
            android:textSize="16sp"
            android:textStyle="italic" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mainDeviceSetupButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/main_device_setup"
            android:textAllCaps="false"
            android:textColor="@color/onecall_white"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/onecall_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondaryDeviceSetupButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/join_as_secondary_device"
            android:textAllCaps="false"
            android:textColor="@color/onecall_blue"
            app:cornerRadius="14dp"
            app:strokeColor="@color/onecall_blue"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
