<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OneCall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.OneCall.FullScreen" parent="Theme.OneCall">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Card style -->
    <style name="Widget.OneCall.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingTop">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.OneCall.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/brand_primary_dark</item>
    </style>

    <!-- Secondary Button -->
    <style name="Widget.OneCall.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Danger Button -->
    <style name="Widget.OneCall.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_decline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Success Button -->
    <style name="Widget.OneCall.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_accept</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Text Button -->
    <style name="Widget.OneCall.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Heading -->
    <style name="TextAppearance.OneCall.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtitle -->
    <style name="TextAppearance.OneCall.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Body -->
    <style name="TextAppearance.OneCall.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Caption -->
    <style name="TextAppearance.OneCall.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- FAB call button style -->
    <style name="Widget.OneCall.FAB.Accept" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="backgroundTint">@color/btn_accept</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <style name="Widget.OneCall.FAB.Decline" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="backgroundTint">@color/btn_decline</item>
        <item name="tint">@color/text_primary</item>
    </style>

</resources>
