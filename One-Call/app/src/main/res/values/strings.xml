    <!-- Tutorial -->
    <string name="tutorial_skip">Skip</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_get_started">Get Started</string>
    <string name="tutorial_card1_title">Welcome to OneCall</string>
    <string name="tutorial_card1_desc">OneCall aapke ek SIM ko doosre phone pe Bluetooth ke through accessible banata hai. Koi internet nahi — sirf Bluetooth.</string>
    <string name="tutorial_card2_title">Main Device Setup</string>
    <string name="tutorial_card2_desc">SIM wale phone pe OneCall kholo. Main Device choose karo. Bluetooth ON karo aur Secondary device ko pair karo.</string>
    <string name="tutorial_card3_title">Secondary Device Connect</string>
    <string name="tutorial_card3_desc">Doosre phone pe OneCall kholo. Secondary choose karo. Scan karo aur Main Device ko pair karo.</string>
    <string name="tutorial_card4_title">Calls on Both Devices</string>
    <string name="tutorial_card4_desc">SIM pe call aaye toh dono devices pe ring bajegi. Koi bhi uthaa sakta hai. Audio Bluetooth HFP se route hoga.</string>
    <string name="tutorial_card5_title">You\'re Ready!</string>
    <string name="tutorial_card5_desc">Setup complete hai. Dashboard pe jao aur OneCall use karna shuru karo.</string>

