<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/transferDeviceIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_caller_avatar_circle"
        android:contentDescription="@string/transfer_call_title"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="@color/onecall_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/transferDeviceNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/onecall_blue_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transferDeviceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/transfer_device_online"
            android:textColor="@color/onecall_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/transferDeviceIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_status_online" />

</LinearLayout>
