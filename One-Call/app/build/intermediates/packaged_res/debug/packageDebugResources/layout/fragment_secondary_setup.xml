<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/secondary_setup_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/secondary_setup_subtitle"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp" />

    <!-- Bluetooth Status -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bluetooth" />

            <TextView
                android:id="@+id/tv_bt_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bluetooth_on"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginStart="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scan Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_scan_devices"
        style="@style/Widget.OneCall.Button.Primary"
        android:layout_marginBottom="16dp" />

    <!-- Nearby Devices Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nearby_devices_header"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Device List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Auto connect status -->
    <TextView
        android:id="@+id/tv_auto_connecting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_connecting"
        android:textSize="14sp"
        android:textColor="@color/brand_secondary"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
